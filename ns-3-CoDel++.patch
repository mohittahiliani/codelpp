+uint16_t
+CoDelQueueDisc::NewtonStepPp(uint16_t recInvSqrt, uint32_t count)
+{
+    NS_LOG_FUNCTION_NOARGS();
+    uint32_t invsqrt = ((uint32_t)recInvSqrt) << REC_INV_SQRT_SHIFT;
+    // Compute invsqrt^2
+    uint32_t invsqrt2 = ((uint64_t)invsqrt * invsqrt) >> 32;
+    uint32_t invsqrt4 = ((uint64_t)invsqrt2 * invsqrt2) >> 32;
+    // Compute the correction factor: (5 - invsqrt^4 * count) / 4
+    uint64_t correction =
+        (5LL << 32) - ((uint64_t)invsqrt4 * count); /* Fixed-point scaling for 5 */
+    correction >>= 3;                               /* avoid overflow */
+    /*Apply the formula: xn+1 = xn * correction */
+    uint32_t val = (correction * invsqrt) >> (32 - 3 + 2);
+    return static_cast<uint16_t>(val >> REC_INV_SQRT_SHIFT);
+}
