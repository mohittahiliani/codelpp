+/*
+ * new_invquadrt = (invquadrt / 4) * (5 - count * invquadrt^4)
+ * 
+ * invquadrt is stored in rec_inv_sqrt variable
+ */
+static void codelpp_Newton_step(struct codel_vars *vars)
+{
+	u32 invquadrt = ((u32)vars->rec_inv_sqrt) << REC_INV_SQRT_SHIFT;
+	u32 invquadrt2 = ((u64)invquadrt * invquadrt) >> 32;
+	u32 invquadrt4 = ((u64)invquadrt2 * invquadrt2) >> 32;
+	u64 val = (5LL << 32) - ((u64)vars->count * invquadrt4);
+
+	val >>= 3; /* avoid overflow in following multiply */
+	val = (val * invquadrt) >> (32 - 3 + 2);
+
+	vars->rec_inv_sqrt = (u16)(val >> REC_INV_SQRT_SHIFT);
+
+	/* store cube of inverse quad root*/
+	invquadrt = (u32) val;
+	u32 invquadrtsq = ((u64)(invquadrt) * invquadrt) >> 32;
+	u32 invquadrtcub = ((u64)(invquadrtsq) * invquadrt) >> 32;
+	vars->rec_inv_quadrt_cube = invquadrtcub >> REC_INV_SQRT_SHIFT;
+}
+
